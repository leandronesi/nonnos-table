{
  "name": "chess-coach-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "test": "npm run test:foundation && npm run test:analytics",
    "test:foundation": "node --test scripts/foundations.test.mjs",
    "test:analytics": "vitest run --config vitest.config.ts",
    "test:mobile": "playwright test",
    "preflight:production": "node scripts/verify-production-env.mjs",
    "preflight:maia": "node scripts/verify-maia-model.mjs",
    "prebuild": "node scripts/assert-no-personal-public-data.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "setup:maia": "node scripts/setup-maia-model.mjs",
    "test:database": "node scripts/verify-learning-database.mjs",
    "preflight:remote": "node scripts/verify-remote-schema.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@supabase/supabase-js": "^2.45.4",
    "chess.js": "^1.0.0-beta.8",
    "lucide-react": "^1.16.0",
    "onnxruntime-web": "^1.23.0",
    "react": "^19.0.0",
    "react-chessboard": "^5.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.15.1",
    "recharts": "^2.13.3",
    "stockfish": "^18.0.7",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "protobufjs": "7.6.5"
  }
}
